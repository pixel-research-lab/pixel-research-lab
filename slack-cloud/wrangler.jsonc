{
  "name": "slack-preview",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": false
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/slack/*"
    ]
  },
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pixel-lab-slack-preview",
      "database_id": "2726128e-d2b4-4f23-b5ae-61482ee4e6c6"
    }
  ],
  "vars": {
    "APP_ORIGIN": "https://slack-preview.pixel-research-lab-2e2guk.workers.dev",
    "FIREBASE_PROJECT": "pixel-research-lab-2e2guk",
    "SLACK_TEAM": "T0CGYVDNL2J",
    "SLACK_CHANNEL": "C0CGKHCP4PR"
  }
}
