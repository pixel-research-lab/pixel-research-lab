rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /players/{uid}/materials/{sha} {
      function ownsFile() { return request.auth != null && request.auth.uid == uid && sha.matches('[a-f0-9]{64}'); }
      allow get: if ownsFile();
      allow create, update: if ownsFile()
        && request.resource.data.keys().hasOnly(['size','type','count'])
        && request.resource.data.size is int && request.resource.data.size > 0 && request.resource.data.size <= 20971520
        && request.resource.data.count is int && request.resource.data.count > 0 && request.resource.data.count <= 86
        && request.resource.data.type in ['application/pdf','image/png','image/jpeg','image/webp','image/gif'];
      match /chunks/{part} {
        allow get, list: if ownsFile();
        allow create, update: if ownsFile() && part.matches('[0-9]{3}')
          && request.resource.data.keys().hasOnly(['bytes']) && request.resource.data.bytes is bytes
          && request.resource.data.bytes.size() > 0 && request.resource.data.bytes.size() <= 245760;
      }
    }
    match /players/{uid}/records/{id} {
      allow get, list: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && id.matches('q~[a-zA-Z0-9_-]+|time~[a-zA-Z0-9_-]{1,100}|review~[a-zA-Z0-9_-]{1,100}|grade~[a-zA-Z0-9_-]{1,100}~[0-9]{4}-[0-9]{2}-[0-9]{2}|slot~[0-2]|gift~[a-zA-Z0-9_-]+|board|field|reviewLimit|reviewDraw|calendarChoice|pet|material~[a-f0-9-]{36}|buy~[a-f0-9-]{36}|place~(studio|garden|roof|river)-(monitor|clock|speaker|calendar|aux|laptop)|look~(studio|garden|roof|river)-(monitor|clock|speaker|calendar|gear)|fit~(room|wall|floor|gear)|axis~(read|design|code|infer|write|s-[a-f0-9-]{36})|(agenda|done|star|claim)~(l-[0-9a-f-]{36}|g-[0-9a-f]{64})')
        && request.resource.data.keys().hasAll(['clock','actor','json'])
        && request.resource.data.keys().hasOnly(['clock','actor','json'])
        && request.resource.data.clock is int && request.resource.data.clock > 0
        && request.resource.data.actor is string && request.resource.data.actor.size() <= 100
        && request.resource.data.json is string && request.resource.data.json.size() <= 100000;
    }
  }
}
